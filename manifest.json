{
  "manifest_version": 3,
  "name": "Michael Caleb EB GAMES AUTO CHECKOUT V 6.9 - Discord Notifications",
  "version": "1.9.0",
  "description": "Stable Core with parallel product tabs, sequential cart-refresh handling, timing diagnostics, and optional Discord webhook notifications.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.ebgames.com.au/*",
    "https://discord.com/*",
    "https://discordapp.com/*"
  ],
  "action": {
    "default_title": "Michael Caleb EB GAMES AUTO CHECKOUT V 6.9",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebgames.com.au/product/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebgames.com.au/shopping-cart*",
        "https://www.ebgames.com.au/cart*"
      ],
      "js": [
        "cart.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
